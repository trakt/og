{
  "workspace": [
    "./projects/client"
  ],
  "nodeModulesDir": "manual",
  "minimumDependencyAge": 1440,
  "tasks": {
    "install": "deno install --frozen",
    "client:dev": "cd projects/client && deno task dev",
    "client:ci": "cd projects/client && deno task ci",
    "client:check": "cd projects/client && deno task check",
    "client:test": "cd projects/client && deno task test",
    "client:build": "cd projects/client && deno task build",
    "client:verify": "cd projects/client && deno task verify",
    "client:land": "cd projects/client && deno task land",
    "client:deploy": "cd projects/client && deno task deploy"
  },
  "unstable": [
    "fmt-component"
  ],
  "fmt": {
    "singleQuote": true,
    "indentWidth": 2,
    "lineWidth": 120,
    "exclude": [
      ".svelte-kit",
      "node_modules",
      "src/lib/icons/**/*.svg"
    ],
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      ".svelte-kit",
      "node_modules"
    ]
  },
  "allowScripts": [
    "npm:workerd@1.20260926.1"
  ]
}
