{
  "nodeModulesDir": "manual",
  "minimumDependencyAge": 1440,
  "tasks": {
    "install": "deno install --frozen",
    "format": "deno fmt && deno lint --fix && deno task lint --fix",
    "icon": "deno run --allow-read --allow-write=src/lib/icons --allow-env=OG_ASSET_PATH scripts/icon.ts",
    "emoji": "deno run --allow-read --allow-write=src/lib/components/comments/text --allow-env=OG_ASSET_PATH scripts/emoji.ts",
    "ci": "deno fmt --check && deno lint && deno task lint && deno task check && deno check scripts && deno task test && deno task build",
    "bump": "deno run --allow-read=. --allow-write --allow-env --allow-net=registry.npmjs.org,npm.jsr.io --allow-run=deno scripts/bump.ts",
    "verify": "bash scripts/verify.sh",
    "land": "bash scripts/land.sh",
    "unblock": "bash scripts/unblock.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "unstable": [
    "fmt-component"
  ],
  "fmt": {
    "singleQuote": true,
    "indentWidth": 2,
    "lineWidth": 120,
    "exclude": [
      ".svelte-kit",
      "node_modules",
      "src/lib/icons/**/*.svg"
    ],
    "proseWrap": "preserve"
  },
  "lint": {
    "exclude": [
      ".svelte-kit",
      "node_modules"
    ]
  },
  "allowScripts": [
    "npm:workerd@1.20260926.1"
  ]
}
